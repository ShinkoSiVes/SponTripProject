# Copy this file to .env and fill in keys.
# Restart `npm run dev` after changing values.
# On Vercel, add the same VITE_ names in Project Settings, then redeploy.

# Recommended: Google Places API (New)
# Enable Places API (New) in Google Cloud, create an API key, restrict by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# Optional fallback: Foursquare Places
VITE_FOURSQUARE_API_KEY=
